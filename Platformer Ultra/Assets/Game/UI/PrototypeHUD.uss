.hud-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    color: rgb(230, 242, 245);
}

.objective-card {
    position: absolute;
    left: 24px;
    top: 24px;
    width: 360px;
    padding: 15px 18px 17px 18px;
    background-color: rgba(8, 15, 19, 0.88);
    border-left-width: 4px;
    border-left-color: rgb(255, 116, 25);
}

.hud-kicker,
.portal-core-title,
.repair-kicker {
    font-size: 11px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(255, 146, 47);
    margin-bottom: 4px;
}

.objective-text {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(235, 245, 248);
    white-space: normal;
}

.broken-machines-panel {
    margin-top: 12px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: rgba(255, 92, 48, 0.55);
    display: none;
}

.repair-kicker {
    color: rgb(255, 103, 67);
}

.broken-machines-text {
    font-size: 14px;
    -unity-font-style: bold;
    color: rgb(255, 161, 128);
    white-space: normal;
}

.portal-core-card {
    position: absolute;
    right: 24px;
    top: 24px;
    min-width: 150px;
    padding: 12px 16px 13px 16px;
    align-items: flex-end;
    background-color: rgba(8, 15, 19, 0.88);
    border-right-width: 4px;
    border-right-color: rgb(99, 224, 255);
}

.portal-core-title {
    color: rgb(150, 211, 224);
}

.portal-core-progress {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(99, 224, 255);
}

.tutorial-tip {
    position: absolute;
    align-self: center;
    top: 70px;
    max-width: 560px;
    padding: 12px 22px;
    background-color: rgba(8, 15, 19, 0.94);
    border-bottom-width: 3px;
    border-bottom-color: rgb(99, 224, 255);
    display: none;
}

.tutorial-tip-text {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(230, 242, 245);
    white-space: normal;
    -unity-text-align: middle-center;
}

.interaction-prompt {
    position: absolute;
    align-self: center;
    bottom: 82px;
    padding: 12px 22px;
    font-size: 18px;
    -unity-font-style: bold;
    color: white;
    background-color: rgba(8, 15, 19, 0.94);
    border-bottom-width: 3px;
    border-bottom-color: rgb(255, 125, 30);
}

.timed-interaction-panel {
    position: absolute;
    align-self: center;
    bottom: 128px;
    width: 390px;
    padding: 13px 18px 15px 18px;
    background-color: rgba(8, 15, 19, 0.96);
    border-left-width: 4px;
    border-left-color: rgb(255, 125, 30);
    display: none;
}

.timed-interaction-label {
    font-size: 16px;
    -unity-font-style: bold;
    color: rgb(255, 177, 80);
    margin-bottom: 8px;
}

.timed-interaction-progress {
    height: 18px;
    background-color: rgb(28, 42, 47);
    --unity-progress-bar-background-color: rgb(28, 42, 47);
    --unity-progress-bar-progress-color: rgb(255, 125, 30);
}

.crosshair {
    position: absolute;
    align-self: center;
    top: 50%;
    width: 18px;
    height: 18px;
}

.crosshair-horizontal {
    position: absolute;
    left: 0;
    top: 8px;
    width: 18px;
    height: 2px;
    background-color: rgba(225, 245, 250, 0.8);
}

.crosshair-vertical {
    position: absolute;
    left: 8px;
    top: 0;
    width: 2px;
    height: 18px;
    background-color: rgba(225, 245, 250, 0.8);
}

.player-health-panel {
    position: absolute;
    left: 24px;
    bottom: 24px;
    width: 300px;
    padding: 12px 15px 14px 15px;
    background-color: rgba(8, 15, 19, 0.92);
    border-left-width: 4px;
    border-left-color: rgb(99, 224, 255);
}

.player-health-heading {
    flex-direction: row;
    justify-content: space-between;
    margin-bottom: 7px;
}

.player-health-title {
    font-size: 13px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(175, 215, 224);
}

.player-health-value {
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(99, 224, 255);
}

.player-health-progress {
    height: 17px;
    background-color: rgb(28, 42, 47);
    --unity-progress-bar-background-color: rgb(28, 42, 47);
    --unity-progress-bar-progress-color: rgb(45, 205, 231);
}

.game-over-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(7, 9, 11, 0.82);
    display: none;
}

.game-over-card {
    width: 460px;
    padding: 30px 38px 34px 38px;
    align-items: center;
    background-color: rgba(10, 17, 21, 0.98);
    border-top-width: 4px;
    border-top-color: rgb(255, 76, 31);
    border-bottom-width: 1px;
    border-bottom-color: rgb(94, 113, 119);
}

.game-over-kicker {
    font-size: 13px;
    letter-spacing: 3px;
    color: rgb(255, 126, 69);
    margin-bottom: 4px;
}

.game-over-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(242, 247, 248);
    margin-bottom: 10px;
}

.game-over-message {
    font-size: 16px;
    color: rgb(170, 190, 196);
    margin-bottom: 24px;
}

.retry-button {
    width: 220px;
    height: 46px;
    font-size: 16px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(10, 17, 21);
    background-color: rgb(255, 126, 38);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.retry-button:hover {
    background-color: rgb(255, 163, 70);
}

.pause-panel,
.victory-panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(5, 9, 13, 0.76);
    display: none;
}

.pause-card,
.settings-card,
.victory-card {
    width: 480px;
    padding: 30px 40px 34px 40px;
    align-items: center;
    background-color: rgba(9, 17, 23, 0.98);
    border-top-width: 4px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 111, 123);
}

.pause-card {
    border-top-color: rgb(99, 224, 255);
}

.settings-card {
    width: 850px;
    max-height: 92%;
    padding: 26px 34px 30px 34px;
    align-items: center;
    background-color: rgba(9, 17, 23, 0.98);
    border-top-width: 4px;
    border-top-color: rgb(99, 224, 255);
    border-bottom-width: 1px;
    border-bottom-color: rgb(80, 111, 123);
    display: none;
}

.settings-content {
    width: 100%;
    flex-direction: row;
    margin-bottom: 16px;
}

.settings-section {
    flex-grow: 1;
    padding: 16px 18px;
    background-color: rgba(18, 31, 39, 0.88);
}

.audio-settings-section {
    width: 43%;
    margin-right: 10px;
}

.controls-section {
    width: 57%;
    margin-left: 10px;
}

.settings-section-title {
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: rgb(99, 224, 255);
    margin-bottom: 12px;
}

.volume-row {
    min-height: 46px;
    flex-direction: row;
    align-items: center;
}

.volume-label {
    width: 74px;
    font-size: 13px;
    -unity-font-style: bold;
    color: rgb(190, 215, 222);
}

.volume-slider {
    flex-grow: 1;
    margin-left: 6px;
    margin-right: 10px;
    --unity-colors-slider-groove-background: rgb(34, 53, 62);
}

.volume-value {
    width: 46px;
    font-size: 13px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(99, 224, 255);
}

.controls-heading-row,
.control-row {
    flex-direction: row;
    min-height: 30px;
    align-items: center;
}

.controls-heading-row {
    border-bottom-width: 1px;
    border-bottom-color: rgba(99, 224, 255, 0.45);
    margin-bottom: 4px;
}

.control-row {
    border-bottom-width: 1px;
    border-bottom-color: rgba(80, 111, 123, 0.28);
}

.control-heading {
    font-size: 10px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    color: rgb(132, 177, 188);
}

.control-action {
    width: 25%;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(225, 238, 241);
}

.control-binding {
    width: 37.5%;
    font-size: 11px;
    color: rgb(168, 199, 207);
}

.victory-card {
    border-top-color: rgb(176, 91, 255);
    background-color: rgba(13, 10, 24, 0.98);
}

.pause-kicker,
.victory-kicker {
    font-size: 13px;
    letter-spacing: 3px;
    margin-bottom: 4px;
}

.pause-kicker {
    color: rgb(99, 224, 255);
}

.victory-kicker {
    color: rgb(202, 142, 255);
}

.pause-title,
.victory-title {
    font-size: 38px;
    -unity-font-style: bold;
    color: rgb(242, 247, 248);
    margin-bottom: 10px;
}

.pause-message,
.victory-message {
    font-size: 16px;
    color: rgb(170, 190, 196);
    margin-bottom: 24px;
}

.primary-menu-button,
.secondary-menu-button,
.victory-button {
    width: 230px;
    height: 46px;
    margin-top: 5px;
    margin-bottom: 5px;
    font-size: 16px;
    letter-spacing: 1px;
    -unity-font-style: bold;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.primary-menu-button {
    color: rgb(8, 16, 20);
    background-color: rgb(99, 224, 255);
}

.primary-menu-button:hover {
    background-color: rgb(151, 238, 255);
}

.secondary-menu-button {
    color: rgb(213, 228, 232);
    background-color: rgb(31, 49, 58);
}

.secondary-menu-button:hover {
    background-color: rgb(48, 69, 79);
}

.victory-button {
    color: rgb(18, 9, 27);
    background-color: rgb(190, 113, 255);
}

.victory-button:hover {
    background-color: rgb(218, 164, 255);
}
