<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="hud-root">
        <ui:VisualElement name="objective-card" class="objective-card">
            <ui:Label text="CURRENT OBJECTIVE" class="hud-kicker" />
            <ui:Label name="current-objective" text="Activate the Mine" class="objective-text" />
            <ui:VisualElement name="broken-machines-panel" class="broken-machines-panel">
                <ui:Label text="REPAIRS NEEDED" class="repair-kicker" />
                <ui:Label name="broken-machines" text="" class="broken-machines-text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="portal-core-card" class="portal-core-card">
            <ui:Label text="PORTAL CORES" class="portal-core-title" />
            <ui:Label name="portal-core-progress" text="0/3" class="portal-core-progress" />
        </ui:VisualElement>
        <ui:VisualElement name="tutorial-tip" class="tutorial-tip">
            <ui:Label name="tutorial-tip-text" text="" class="tutorial-tip-text" />
        </ui:VisualElement>
        <ui:VisualElement class="crosshair">
            <ui:VisualElement class="crosshair-horizontal" />
            <ui:VisualElement class="crosshair-vertical" />
        </ui:VisualElement>
        <ui:VisualElement class="player-health-panel">
            <ui:VisualElement class="player-health-heading">
                <ui:Label text="SUIT INTEGRITY" class="player-health-title" />
                <ui:Label name="player-health-value" text="100 / 100" class="player-health-value" />
            </ui:VisualElement>
            <ui:ProgressBar name="player-health-progress" low-value="0" high-value="100" value="100" class="player-health-progress" />
        </ui:VisualElement>
        <ui:Label name="interaction-prompt" text="" class="interaction-prompt" />
        <ui:VisualElement name="timed-interaction-panel" class="timed-interaction-panel">
            <ui:Label name="timed-interaction-label" text="Repairing" class="timed-interaction-label" />
            <ui:ProgressBar name="timed-interaction-progress" low-value="0" high-value="100" value="0" class="timed-interaction-progress" />
        </ui:VisualElement>
        <ui:VisualElement name="game-over-panel" class="game-over-panel">
            <ui:VisualElement class="game-over-card">
                <ui:Label text="SYSTEM FAILURE" class="game-over-kicker" />
                <ui:Label text="GAME OVER" class="game-over-title" />
                <ui:Label text="Factory defense link terminated." class="game-over-message" />
                <ui:Button name="retry-button" text="RETRY FACTORY" class="retry-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-panel" class="pause-panel">
            <ui:VisualElement class="pause-card">
                <ui:Label text="OPERATIONS SUSPENDED" class="pause-kicker" />
                <ui:Label text="PAUSED" class="pause-title" />
                <ui:Label text="The factory simulation is holding position." class="pause-message" />
                <ui:Button name="resume-button" text="RESUME" class="primary-menu-button" />
                <ui:Button name="pause-retry-button" text="RETRY FACTORY" class="secondary-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="victory-panel" class="victory-panel">
            <ui:VisualElement class="victory-card">
                <ui:Label text="PRODUCTION CHAIN RESTORED" class="victory-kicker" />
                <ui:Label text="FACTORY SECURED" class="victory-title" />
                <ui:Label text="The portal is stable. You escaped the vertical factory." class="victory-message" />
                <ui:Button name="victory-retry-button" text="REPLAY FACTORY" class="victory-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
