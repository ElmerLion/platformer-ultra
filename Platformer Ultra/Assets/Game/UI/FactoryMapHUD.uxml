<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="hud-root">
        <ui:VisualElement name="objective-card" class="objective-card">
            <ui:Label text="CURRENT OBJECTIVE" class="hud-kicker" />
            <ui:Label name="current-objective" text="Restore production: Activate the Mine" class="objective-text" />
            <ui:VisualElement name="broken-machines-panel" class="broken-machines-panel">
                <ui:Label text="REPAIRS NEEDED" class="repair-kicker" />
                <ui:Label name="broken-machines" text="" class="broken-machines-text" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="portal-core-card" class="portal-core-card">
            <ui:Label text="PORTAL CORES" class="portal-core-title" />
            <ui:Label name="portal-core-progress" text="0/3" class="portal-core-progress" />
        </ui:VisualElement>
        <ui:VisualElement name="tutorial-tip" class="tutorial-tip">
            <ui:Label name="tutorial-tip-text" text="" class="tutorial-tip-text" />
        </ui:VisualElement>
        <ui:VisualElement class="crosshair">
            <ui:VisualElement class="crosshair-horizontal" />
            <ui:VisualElement class="crosshair-vertical" />
        </ui:VisualElement>
        <ui:VisualElement class="player-health-panel">
            <ui:VisualElement class="player-health-heading">
                <ui:Label text="CHASSIS INTEGRITY" class="player-health-title" />
                <ui:Label name="player-health-value" text="100 / 100" class="player-health-value" />
            </ui:VisualElement>
            <ui:ProgressBar name="player-health-progress" low-value="0" high-value="100" value="100" class="player-health-progress" />
        </ui:VisualElement>
        <ui:Label name="interaction-prompt" text="" class="interaction-prompt" />
        <ui:VisualElement name="timed-interaction-panel" class="timed-interaction-panel">
            <ui:Label name="timed-interaction-label" text="Repairing" class="timed-interaction-label" />
            <ui:ProgressBar name="timed-interaction-progress" low-value="0" high-value="100" value="0" class="timed-interaction-progress" />
        </ui:VisualElement>
        <ui:VisualElement name="game-over-panel" class="game-over-panel">
            <ui:VisualElement class="game-over-card">
                <ui:Label text="SYSTEM FAILURE" class="game-over-kicker" />
                <ui:Label text="GAME OVER" class="game-over-title" />
                <ui:Label text="Maintenance unit destroyed. Factory control lost." class="game-over-message" />
                <ui:Button name="retry-button" text="RETRY FACTORY" class="retry-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-panel" class="pause-panel">
            <ui:VisualElement name="pause-card" class="pause-card">
                <ui:Label text="OPERATIONS SUSPENDED" class="pause-kicker" />
                <ui:Label text="PAUSED" class="pause-title" />
                <ui:Label text="Emergency operations suspended." class="pause-message" />
                <ui:Button name="resume-button" text="RESUME" class="primary-menu-button" />
                <ui:Button name="options-button" text="OPTIONS" class="secondary-menu-button" />
                <ui:Button name="pause-retry-button" text="RETRY FACTORY" class="secondary-menu-button" />
            </ui:VisualElement>
            <ui:VisualElement name="settings-card" class="settings-card">
                <ui:Label text="SYSTEM CONFIGURATION" class="pause-kicker" />
                <ui:Label text="OPTIONS" class="pause-title" />
                <ui:VisualElement class="settings-content">
                    <ui:VisualElement class="settings-section audio-settings-section">
                        <ui:Label text="AUDIO" class="settings-section-title" />
                        <ui:VisualElement class="volume-row">
                            <ui:Label text="MASTER" class="volume-label" />
                            <ui:Slider name="master-volume-slider" low-value="0" high-value="100" value="100" class="volume-slider" />
                            <ui:Label name="master-volume-value" text="100%" class="volume-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="volume-row">
                            <ui:Label text="MUSIC" class="volume-label" />
                            <ui:Slider name="music-volume-slider" low-value="0" high-value="100" value="100" class="volume-slider" />
                            <ui:Label name="music-volume-value" text="100%" class="volume-value" />
                        </ui:VisualElement>
                        <ui:VisualElement class="volume-row">
                            <ui:Label text="SFX" class="volume-label" />
                            <ui:Slider name="sfx-volume-slider" low-value="0" high-value="100" value="100" class="volume-slider" />
                            <ui:Label name="sfx-volume-value" text="100%" class="volume-value" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="settings-section controls-section">
                        <ui:Label text="CONTROLS" class="settings-section-title" />
                        <ui:VisualElement class="controls-heading-row">
                            <ui:Label text="ACTION" class="control-heading control-action" />
                            <ui:Label text="KEYBOARD / MOUSE" class="control-heading control-binding" />
                            <ui:Label text="GAMEPAD" class="control-heading control-binding" />
                        </ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Move" class="control-action" /><ui:Label text="WASD" class="control-binding" /><ui:Label text="Left Stick" class="control-binding" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Look" class="control-action" /><ui:Label text="Mouse" class="control-binding" /><ui:Label text="Right Stick" class="control-binding" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Jump" class="control-action" /><ui:Label text="Space" class="control-binding" /><ui:Label text="South Button" class="control-binding" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Dash" class="control-action" /><ui:Label text="Left Shift" class="control-binding" /><ui:Label text="Left Stick Press / East Button" class="control-binding" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Interact" class="control-action" /><ui:Label text="E" class="control-binding" /><ui:Label text="West Button" class="control-binding" /></ui:VisualElement>
                        <ui:VisualElement class="control-row"><ui:Label text="Pause" class="control-action" /><ui:Label text="Escape" class="control-binding" /><ui:Label text="Start" class="control-binding" /></ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:Button name="settings-back-button" text="BACK" class="secondary-menu-button" />
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="victory-panel" class="victory-panel">
            <ui:VisualElement class="victory-card">
                <ui:Label text="PRODUCTION CHAIN RESTORED" class="victory-kicker" />
                <ui:Label text="EVACUATION COMPLETE" class="victory-title" />
                <ui:Label text="Portal stabilized. The maintenance unit escaped before factory control was lost." class="victory-message" />
                <ui:Button name="victory-retry-button" text="REPLAY FACTORY" class="victory-button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
